POSTGRES_PORT=5434
POSTGRES_DB=precia_landing
POSTGRES_USER=precia_landing
POSTGRES_PASSWORD=precia_landing

DATABASE_URL="postgresql://precia_landing:precia_landing@localhost:5434/precia_landing"

NEXT_PUBLIC_SITE_URL="https://precia.site"

# Base URL of the user documentation site (precia-docs), footer link.
NEXT_PUBLIC_DOCS_URL="https://docs.precia.site"

# Required, no code fallback. Where the navbar and footer "Login" links send
# every visitor. Jenkins sets this per branch: https://app-dev.precia.site on
# dev, https://app.precia.site on main. The build fails without it.
NEXT_PUBLIC_APP_URL="https://app.precia.site"
